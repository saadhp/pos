<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_live_pm_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.live.pm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_payment_method_ids']" position="attributes">
                <attribute name="readonly">False</attribute>
            </xpath>
            <xpath expr="//field[@name='pos_payment_method_ids']" position="after">
                <div
                    class="text-muted small mt-1"
                    invisible="not pos_has_active_session"
                >
                    Non-cash payment methods can be added while a session is open. Existing methods can only be removed after closing the session.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
